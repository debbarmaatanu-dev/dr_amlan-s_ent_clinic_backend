{
  "name": "dr_amlan-s_ent_clinic-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm test",
    "lint": "npx eslint .",
    "format": "npx prettier . --write",
    "allow-scripts": "npx allow-scripts auto"
  },
  "keywords": [],
  "author": {
    "name": "Atanu Debbarma",
    "url": "https://github.com/AtanuDebbarma"
  },
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/debbarmaatanu-dev/dr_amlan-s_ent_clinic_backend"
  },
  "description": "Express Backend for Dr. Amlan's ENT Clinic",
  "dependencies": {
    "@phonepe-pg/pg-sdk-node": "2.0.6",
    "cloudinary": "2.10.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "fallow": "2.98.0",
    "firebase-admin": "13.8.0",
    "helmet": "8.2.0",
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lavamoat/allow-scripts": "5.0.2",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.3",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "trustedDependencies": [
    "unrs-resolver",
    "@firebase/util",
    "protobufjs"
  ],
  "lavamoat": {
    "allowScripts": {
      "eslint-import-resolver-typescript>unrs-resolver#1.11.1": true,
      "firebase-admin>@firebase/database-types>@firebase/util#1.15.0": true,
      "firebase-admin>@google-cloud/firestore>protobufjs#7.5.6": true
    }
  },
  "overrides": {
    "class-transformer": "0.3.2",
    "uuid": "11.1.1"
  }
}
