# Backend environment variables
# Copy to `.env` for local development (do NOT commit `.env`).
#
# Notes:
# - This backend is deployed as a separate Vercel project.
# - Webhook requests may arrive without an Origin header; CORS is intentionally permissive only for webhook/health paths.

# -------------------------
# Core runtime
# -------------------------
NODE_ENV=development
PORT=3000

# Enable extra logs in some payment/webhook paths
ENABLE_DEBUG_LOGS=false

# -------------------------
# Frontend origins (CORS + redirects)
# -------------------------
# Local frontend (Vite dev server)
FRONTEND_LOCAL=http://localhost:5173

# Optional: Vercel preview frontend URL or wildcard-like stable host you use
FRONTEND_VERCEL=

# Primary frontend domain used for redirects/callback URLs
# Example: https://www.example.com
FRONTEND_DNS=

# Optional: apex/root host (if you allow it in CORS)
FRONTEND_ROOT=

# -------------------------
# Firebase Admin (server-side)
# -------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# IMPORTANT: keep newlines escaped as \n in env variables
FIREBASE_PRIVATE_KEY=

# -------------------------
# Admin allowlist (server-side authorization)
# -------------------------
ADMIN_EMAIL1=
ADMIN_EMAIL2=

# -------------------------
# PhonePe
# -------------------------
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# SANDBOX or PRODUCTION
PHONEPE_ENV=SANDBOX

# Webhook validation credentials (from PhonePe dashboard/config)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# -------------------------
# Cloudinary
# -------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

